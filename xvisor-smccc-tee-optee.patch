 diff --git a/arch/arm/cpu/common/optee.c b/arch/arm/cpu/common/optee.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/arm/cpu/common/optee.c
@@ -0,0 +1,234 @@
+/**
+ * Copyright (c) 2024
+ * All rights reserved.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2, or (at your option)
+ * any later version.
+ * 
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ * 
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+ *
+ * @file optee.c
+ * @brief OP-TEE mediator implementation
+ */
+
+#include <vmm_error.h>
+#include <vmm_stdio.h>
+#include <vmm_string.h>
+#include <vmm_manager.h>
+#include <vmm_host_aspace.h>
+#include <vmm_malloc.h>
+#include <cpu_vcpu_helper.h>
+#include <smccc.h>
+#include <optee_smc.h>
+#include <tee.h>
+#include <arch_barrier.h>
+#include <arch_regs.h>
+
+/* Forward declaration for actual SMC call to OP-TEE */
+static u32 optee_smc_call(u32 func_id, u32 a1, u32 a2, u32 a3,
+			  u32 a4, u32 a5, u32 a6, u32 a7,
+			  u32 *ret_a1, u32 *ret_a2, u32 *ret_a3)
+{
+	/* This is a placeholder - in real implementation, this would
+	 * make an actual SMC call to OP-TEE running in secure world.
+	 * For now, we return UNKNOWN_FUNCTION to indicate that OP-TEE
+	 * is not available.
+	 */
+	if (ret_a1)
+		*ret_a1 = 0;
+	if (ret_a2)
+		*ret_a2 = 0;
+	if (ret_a3)
+		*ret_a3 = 0;
+	return OPTEE_SMC_RETURN_UNKNOWN_FUNCTION;
+}
+
+/* OP-TEE domain context */
+struct optee_guest {
+	u32 client_id;
+	bool initialized;
+};
+
+static bool optee_probe(void)
+{
+	u32 ret_a1, ret_a2, ret_a3;
+
+	/* Check UID */
+	u32 ret = optee_smc_call(OPTEE_SMC_CALLS_UID, 0, 0, 0, 0, 0, 0, 0,
+				 &ret_a1, &ret_a2, &ret_a3);
+
+	if (ret != OPTEE_SMC_RETURN_OK)
+		return false;
+
+	if (ret_a1 != OPTEE_MSG_UID_0 ||
+	    ret_a2 != OPTEE_MSG_UID_1 ||
+	    ret_a3 != OPTEE_MSG_UID_2)
+		return false;
+
+	/* Check for virtualization support */
+	ret = optee_smc_call(OPTEE_SMC_VM_DESTROYED, 0, 0, 0, 0, 0, 0, 0,
+			     &ret_a1, &ret_a2, &ret_a3);
+	if (ret == OPTEE_SMC_RETURN_UNKNOWN_FUNCTION)
+		return false;
+
+	return true;
+}
+
+static void optee_init_secondary(void)
+{
+	/* Nothing to do for secondary CPUs */
+}
+
+static int optee_guest_init(struct vmm_guest *guest)
+{
+	struct optee_guest *ctx;
+	u32 ret_a1, ret_a2, ret_a3;
+	u32 ret;
+
+	ctx = vmm_zalloc(sizeof(*ctx));
+	if (!ctx)
+		return VMM_ENOMEM;
+
+	/* Client ID 0 is reserved for the hypervisor itself */
+	ctx->client_id = guest->id + 1;
+
+	/* Inform OP-TEE about a new guest */
+	ret = optee_smc_call(OPTEE_SMC_VM_CREATED, ctx->client_id, 0, 0, 0, 0, 0, 0,
+			     &ret_a1, &ret_a2, &ret_a3);
+	if (ret != OPTEE_SMC_RETURN_OK) {
+		vmm_printf("%s: Unable to create OPTEE client for guest %s: rc = 0x%X\n",
+			   __func__, guest->name, ret);
+		vmm_free(ctx);
+		return VMM_ENODEV;
+	}
+
+	ctx->initialized = true;
+	arm_guest_priv(guest)->tee = ctx;
+
+	return VMM_OK;
+}
+
+static int optee_guest_teardown(struct vmm_guest *guest)
+{
+	struct optee_guest *ctx = arm_guest_priv(guest)->tee;
+	u32 ret_a1, ret_a2, ret_a3;
+
+	if (!ctx || !ctx->initialized)
+		return VMM_OK;
+
+	/* Inform OP-TEE that guest is being destroyed */
+	optee_smc_call(OPTEE_SMC_VM_DESTROYED, ctx->client_id, 0, 0, 0, 0, 0, 0,
+		       &ret_a1, &ret_a2, &ret_a3);
+
+	return VMM_OK;
+}
+
+static void optee_free_guest_ctx(struct vmm_guest *guest)
+{
+	struct optee_guest *ctx = arm_guest_priv(guest)->tee;
+
+	if (ctx) {
+		vmm_free(ctx);
+		arm_guest_priv(guest)->tee = NULL;
+	}
+}
+
+static int optee_relinquish_resources(struct vmm_guest *guest)
+{
+	/* For now, nothing to do */
+	return VMM_OK;
+}
+
+static bool optee_handle_call(struct vmm_vcpu *vcpu, arch_regs_t *regs)
+{
+	struct optee_guest *ctx = arm_guest_priv(vcpu->guest)->tee;
+	u32 func_id = (u32)cpu_vcpu_reg_read(vcpu, regs, 0);
+	u32 ret_a1, ret_a2, ret_a3;
+	u32 ret;
+
+	if (!ctx || !ctx->initialized) {
+		cpu_vcpu_reg_write(vcpu, regs, 0,
+				  OPTEE_SMC_RETURN_UNKNOWN_FUNCTION);
+		return true;
+	}
+
+	switch (func_id) {
+	case OPTEE_SMC_CALLS_COUNT:
+		cpu_vcpu_reg_write(vcpu, regs, 0, OPTEE_MEDIATOR_SMC_COUNT);
+		return true;
+
+	case OPTEE_SMC_CALLS_UID:
+		cpu_vcpu_reg_write(vcpu, regs, 0, OPTEE_MSG_UID_0);
+		cpu_vcpu_reg_write(vcpu, regs, 1, OPTEE_MSG_UID_1);
+		cpu_vcpu_reg_write(vcpu, regs, 2, OPTEE_MSG_UID_2);
+		cpu_vcpu_reg_write(vcpu, regs, 3, OPTEE_MSG_UID_3);
+		return true;
+
+	case OPTEE_SMC_CALLS_REVISION:
+		cpu_vcpu_reg_write(vcpu, regs, 0, OPTEE_MSG_REVISION_MAJOR);
+		cpu_vcpu_reg_write(vcpu, regs, 1, OPTEE_MSG_REVISION_MINOR);
+		return true;
+
+	case OPTEE_SMC_CALL_WITH_ARG:
+	{
+		/* Forward the call to OP-TEE */
+		u32 a1 = cpu_vcpu_reg_read(vcpu, regs, 1);
+		u32 a2 = cpu_vcpu_reg_read(vcpu, regs, 2);
+		u32 a3 = cpu_vcpu_reg_read(vcpu, regs, 3);
+		u32 a4 = cpu_vcpu_reg_read(vcpu, regs, 4);
+		u32 a5 = cpu_vcpu_reg_read(vcpu, regs, 5);
+		u32 a6 = cpu_vcpu_reg_read(vcpu, regs, 6);
+		u32 a7 = ctx->client_id; /* Hypervisor Client ID */
+
+		ret = optee_smc_call(func_id, a1, a2, a3, a4, a5, a6, a7,
+				     &ret_a1, &ret_a2, &ret_a3);
+
+		cpu_vcpu_reg_write(vcpu, regs, 0, ret);
+		cpu_vcpu_reg_write(vcpu, regs, 1, ret_a1);
+		cpu_vcpu_reg_write(vcpu, regs, 2, ret_a2);
+		cpu_vcpu_reg_write(vcpu, regs, 3, ret_a3);
+		return true;
+	}
+
+	default:
+		/* Forward unknown calls to OP-TEE */
+		u32 a1 = cpu_vcpu_reg_read(vcpu, regs, 1);
+		u32 a2 = cpu_vcpu_reg_read(vcpu, regs, 2);
+		u32 a3 = cpu_vcpu_reg_read(vcpu, regs, 3);
+		u32 a4 = cpu_vcpu_reg_read(vcpu, regs, 4);
+		u32 a5 = cpu_vcpu_reg_read(vcpu, regs, 5);
+		u32 a6 = cpu_vcpu_reg_read(vcpu, regs, 6);
+		u32 a7 = ctx->client_id;
+
+		ret = optee_smc_call(func_id, a1, a2, a3, a4, a5, a6, a7,
+				     &ret_a1, &ret_a2, &ret_a3);
+
+		cpu_vcpu_reg_write(vcpu, regs, 0, ret);
+		cpu_vcpu_reg_write(vcpu, regs, 1, ret_a1);
+		cpu_vcpu_reg_write(vcpu, regs, 2, ret_a2);
+		cpu_vcpu_reg_write(vcpu, regs, 3, ret_a3);
+		return true;
+	}
+}
+
+static const struct tee_mediator_ops optee_ops = {
+	.probe = optee_probe,
+	.init_secondary = optee_init_secondary,
+	.guest_init = optee_guest_init,
+	.guest_teardown = optee_guest_teardown,
+	.free_guest_ctx = optee_free_guest_ctx,
+	.relinquish_resources = optee_relinquish_resources,
+	.handle_call = optee_handle_call,
+};
+
+REGISTER_TEE_MEDIATOR(optee, "OP-TEE", TEE_TYPE_OPTEE, &optee_ops);
+
+
+
