+ * Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+ *
+ * @file tee.h
+ * @brief Generic part of TEE mediator subsystem
+ */
+
+#ifndef __TEE_H__
+#define __TEE_H__
+
+#include <vmm_types.h>
+#include <vmm_manager.h>
+
+#define TEE_TYPE_NONE    0
+#define TEE_TYPE_OPTEE   1
+
+struct tee_mediator_ops {
+	/*
+	 * Probe for TEE. Should return true if TEE found and
+	 * mediator is initialized.
+	 */
+	bool (*probe)(void);
+
+	/* Initialize secondary CPUs */
+	void (*init_secondary)(void);
+
+	/*
+	 * Called during guest construction if toolstack requests to enable
+	 * TEE support so mediator can inform TEE about new
+	 * guest and create own structures for the new guest.
+	 */
+	int (*guest_init)(struct vmm_guest *guest);
+	int (*guest_teardown)(struct vmm_guest *guest);
+	void (*free_guest_ctx)(struct vmm_guest *guest);
+
+	/*
+	 * Called during guest destruction to relinquish resources used
+	 * by mediator itself. This function can return -ERESTART to indicate
+	 * that it does not finished work and should be called again.
+	 */
+	int (*relinquish_resources)(struct vmm_guest *guest);
+
+	/* Handle SMCCC call for current guest. */
+	bool (*handle_call)(struct vmm_vcpu *vcpu, arch_regs_t *regs);
+};
+
+struct tee_mediator_desc {
+	/* Printable name of the TEE. */
+	const char *name;
+
+	/* Command line name of the TEE (to be used with tee= cmdline option) */
+	const char *cmdline_name;
+
+	/* Mediator callbacks as described above. */
+	const struct tee_mediator_ops *ops;
+
+	/*
+	 * ID of TEE. Should be one of TEE_TYPE_xxx
+	 */
+	u16 tee_type;
+};
+
+bool tee_handle_call(struct vmm_vcpu *vcpu, arch_regs_t *regs);
+int tee_guest_init(struct vmm_guest *guest, u16 tee_type);
+int tee_guest_teardown(struct vmm_guest *guest);
+int tee_relinquish_resources(struct vmm_guest *guest);
+u16 tee_get_type(void);
+void init_tee_secondary(void);
+void tee_free_guest_ctx(struct vmm_guest *guest);
+int __init tee_init(void);
+
+#define REGISTER_TEE_MEDIATOR(_name, _namestr, _type, _ops)         \
+static const struct tee_mediator_desc __tee_desc_##_name __used     \
+__attribute__((section(".teemediator.info"))) = {                  \
+	.name = _namestr,                                               \
+	.cmdline_name = #_name,                                         \
+	.ops = _ops,                                                    \
+	.tee_type = _type                                               \
+}
+
+#endif /* __TEE_H__ */
+
+
+
