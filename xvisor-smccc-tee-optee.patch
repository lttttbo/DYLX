+#ifndef __OPTEE_SMC_H__
+#define __OPTEE_SMC_H__
+
+#include <smccc.h>
+
+#define OPTEE_SMC_STD_CALL_VAL(func_num) \
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_STD_CALL, ARM_SMCCC_CONV_32, \
+			   ARM_SMCCC_OWNER_TRUSTED_OS, (func_num))
+#define OPTEE_SMC_FAST_CALL_VAL(func_num) \
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_CONV_32, \
+			   ARM_SMCCC_OWNER_TRUSTED_OS, (func_num))
+
+/*
+ * Function specified by SMC Calling convention.
+ */
+#define OPTEE_SMC_FUNCID_CALLS_COUNT	0xFF00
+#define OPTEE_SMC_CALLS_COUNT \
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_CONV_32, \
+			   ARM_SMCCC_OWNER_TRUSTED_OS_END, \
+			   OPTEE_SMC_FUNCID_CALLS_COUNT)
+
+#define OPTEE_SMC_FUNCID_CALLS_UID	0xFF01
+#define OPTEE_SMC_CALLS_UID \
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_CONV_32, \
+			   ARM_SMCCC_OWNER_TRUSTED_OS_END, \
+			   OPTEE_SMC_FUNCID_CALLS_UID)
+
+#define OPTEE_SMC_FUNCID_CALLS_REVISION	0xFF03
+#define OPTEE_SMC_CALLS_REVISION \
+	ARM_SMCCC_CALL_VAL(ARM_SMCCC_FAST_CALL, ARM_SMCCC_CONV_32, \
+			   ARM_SMCCC_OWNER_TRUSTED_OS_END, \
+			   OPTEE_SMC_FUNCID_CALLS_REVISION)
+
+#define OPTEE_SMC_FUNCID_CALL_WITH_ARG	0
+#define OPTEE_SMC_CALL_WITH_ARG \
+	OPTEE_SMC_STD_CALL_VAL(OPTEE_SMC_FUNCID_CALL_WITH_ARG)
+
+/* OP-TEE return codes */
+#define OPTEE_SMC_RETURN_OK			0x0
+#define OPTEE_SMC_RETURN_ETHREAD_LIMIT		0x1
+#define OPTEE_SMC_RETURN_EBADADDR		0x2
+#define OPTEE_SMC_RETURN_EBADCMD		0x3
+#define OPTEE_SMC_RETURN_IS_RPC(x)		((x) & 0xFFFF0000)
+#define OPTEE_SMC_RETURN_UNKNOWN_FUNCTION	0xFFFFFFFF
+
+/* OP-TEE UID */
+#define OPTEE_MSG_UID_0	0x384fb3e0U
+#define OPTEE_MSG_UID_1	0xe7f811e3U
+#define OPTEE_MSG_UID_2	0xaf630002U
+#define OPTEE_MSG_UID_3	0xa5d5c51bU
+
+/* OP-TEE revision */
+#define OPTEE_MSG_REVISION_MAJOR	2
+#define OPTEE_MSG_REVISION_MINOR	0
+
+/* OP-TEE VM management */
+#define OPTEE_SMC_FUNCID_VM_CREATED	0x10
+#define OPTEE_SMC_VM_CREATED \
+	OPTEE_SMC_FAST_CALL_VAL(OPTEE_SMC_FUNCID_VM_CREATED)
+
+#define OPTEE_SMC_FUNCID_VM_DESTROYED	0x11
+#define OPTEE_SMC_VM_DESTROYED \
+	OPTEE_SMC_FAST_CALL_VAL(OPTEE_SMC_FUNCID_VM_DESTROYED)
+
+/* Number of SMCs known to the mediator */
+#define OPTEE_MEDIATOR_SMC_COUNT	11
