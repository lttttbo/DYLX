+ static void optee_handle_get_thread_count(struct optee_ctx *ctx,
+                                           struct vmm_vcpu *vcpu,
+                                           arch_regs_t *regs)
+ {
+         struct arm_smccc_res res;
+         u32 secure_threads, max_calls, guest_threads;
+
+         /* Query with this Guest's client ID, never a Guest-supplied a7. */
+         optee_smc_call(ctx->client_id, OPTEE_SMC_GET_THREAD_COUNT,
+                        0, 0, 0, 0, 0, 0, &res);
+         if ((u32)res.a0 != OPTEE_SMC_RETURN_OK) {
+                 /* On failure the ABI preserves a1-a7. */
+                 cpu_vcpu_reg_write(vcpu, regs, 0, res.a0);
+                 return;
+         }
+
+         secure_threads = (u32)res.a1;
+         vmm_spin_lock(&ctx->lock);
+         max_calls = ctx->max_calls;
+         vmm_spin_unlock(&ctx->lock);
+
+         /* Report total capacity, not max_calls minus active calls. */
+         guest_threads = secure_threads < max_calls ? secure_threads : max_calls;
+         if (!guest_threads) {
+                 cpu_vcpu_reg_write(vcpu, regs, 0,
+                                    OPTEE_SMC_RETURN_UNKNOWN_FUNCTION);
+                 return;
+         }
+
+         OPTEE_FLOW_DBG("get_thread_count: client_id=%u secure=%u limit=%u exposed=%u",
+                        ctx->client_id, secure_threads, max_calls, guest_threads);
+         /* The successful query only changes a0 and a1; preserve a2-a7. */
+         cpu_vcpu_reg_write(vcpu, regs, 0, OPTEE_SMC_RETURN_OK);
+         cpu_vcpu_reg_write(vcpu, regs, 1, guest_threads);
+ }
+
  static void optee_handle_get_shm_config(struct vmm_vcpu *vcpu, arch_regs_t *regs)
  {
          /* multi-VM mediator forbids global static SHM for guests */
          cpu_vcpu_reg_write(vcpu, regs, 0, OPTEE_SMC_RETURN_ENOTAVAIL);
  }
