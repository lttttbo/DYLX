diff --git a/arch/arm/cpu/common/tee.c b/arch/arm/cpu/common/tee.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/arm/cpu/common/tee.c
@@ -0,0 +1,129 @@
+/**
+ * Copyright (c) 2024
+ * All rights reserved.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2, or (at your option)
+ * any later version.
+ * 
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ * 
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+ *
+ * @file tee.c
+ * @brief Generic part of TEE mediator subsystem
+ */
+
+#include <vmm_error.h>
+#include <vmm_stdio.h>
+#include <vmm_string.h>
+#include <vmm_manager.h>
+#include <tee.h>
+
+extern const struct tee_mediator_desc __start_teemediator_info[];
+extern const struct tee_mediator_desc __stop_teemediator_info[];
+
+static const struct tee_mediator_desc *cur_mediator;
+
+/* Select the TEE mediator using a name on command line. */
+static char opt_mediator[16] = "";
+
+/*
+ * TODO: Add function to alter Guest DTB, so we can properly describe
+ * present TEE.
+ */
+
+bool tee_handle_call(struct vmm_vcpu *vcpu, arch_regs_t *regs)
+{
+	if (!cur_mediator)
+		return false;
+
+	return cur_mediator->ops->handle_call(vcpu, regs);
+}
+
+int tee_guest_init(struct vmm_guest *guest, u16 tee_type)
+{
+	if (tee_type == TEE_TYPE_NONE)
+		return VMM_OK;
+
+	if (!cur_mediator)
+		return VMM_ENODEV;
+
+	if (cur_mediator->tee_type != tee_type)
+		return VMM_EINVALID;
+
+	return cur_mediator->ops->guest_init(guest);
+}
+
+int tee_guest_teardown(struct vmm_guest *guest)
+{
+	if (!cur_mediator)
+		return VMM_OK;
+
+	return cur_mediator->ops->guest_teardown(guest);
+}
+
+int tee_relinquish_resources(struct vmm_guest *guest)
+{
+	if (!cur_mediator)
+		return VMM_OK;
+
+	return cur_mediator->ops->relinquish_resources(guest);
+}
+
+u16 tee_get_type(void)
+{
+	if (!cur_mediator)
+		return TEE_TYPE_NONE;
+
+	return cur_mediator->tee_type;
+}
+
+int __init tee_init(void)
+{
+	const struct tee_mediator_desc *desc;
+	bool select_mediator = (strlen(opt_mediator) > 0);
+
+	if (select_mediator)
+		vmm_printf("TEE Mediator %s selected from command line\n",
+			   opt_mediator);
+
+	/*
+	 * When a specific TEE is selected using the 'tee=' command line
+	 * argument, we panic if the probe fails or if the requested TEE is not
+	 * supported.
+	 */
+	for (desc = __start_teemediator_info;
+	     desc < __stop_teemediator_info; desc++) {
+		if (select_mediator &&
+		    strncmp(opt_mediator, desc->cmdline_name,
+			    sizeof(opt_mediator)))
+			continue;
+
+		if (desc->ops->probe()) {
+			vmm_printf("Using TEE mediator for %s\n", desc->name);
+			cur_mediator = desc;
+			return VMM_OK;
+		} else if (select_mediator) {
+			vmm_panic("TEE mediator %s from command line probe failed\n",
+				  opt_mediator);
+			return VMM_EFAULT;
+		}
+	}
+
+	if (select_mediator) {
+		vmm_panic("TEE Mediator %s from command line not supported\n",
+			  opt_mediator);
+		return VMM_EINVALID;
+	}
+
+	return VMM_OK;
+}
+
+void init_tee_secondary(void)
+{
+	if (cur_mediator && cur_mediator->ops->init_secondary)
+		cur_mediator->ops->init_secondary();
+}
+
+void tee_free_guest_ctx(struct vmm_guest *guest)
+{
+	if (cur_mediator && cur_mediator->ops->free_guest_ctx)
+		cur_mediator->ops->free_guest_ctx(guest);
+}
+
+
+
diff --git a/arch/arm/cpu/common/vsmccc.c b/arch/arm/cpu/common/vsmccc.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/arm/cpu/common/vsmccc.c
@@ -0,0 +1,270 @@
+/**
+ * Copyright (c) 2024
+ * All rights reserved.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2, or (at your option)
+ * any later version.
+ * 
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ * 
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+ *
+ * @file vsmccc.c
+ * @brief Generic handler for SMC and HVC calls according to ARM SMC Calling Convention
+ */
+
+#include <vmm_error.h>
+#include <vmm_stdio.h>
+#include <vmm_manager.h>
+#include <cpu_vcpu_helper.h>
+#include <emulate_psci.h>
+#include <smccc.h>
+#include <vsmccc.h>
+#ifdef CONFIG_ARM_64
+#include <cpu_defines.h>
+#endif
+
+#include <tee.h>
+
+static bool fill_uid(struct vmm_vcpu *vcpu, arch_regs_t *regs, u32 uid0,
+		     u32 uid1, u32 uid2, u32 uid3)
+{
+	/*
+	 * UID is returned in registers r0..r3, four bytes per register,
+	 * first byte is stored in low-order bits of a register.
+	 * (ARM DEN 0028B page 14)
+	 */
+	cpu_vcpu_reg_write(vcpu, regs, 0, uid0);
+	cpu_vcpu_reg_write(vcpu, regs, 1, uid1);
+	cpu_vcpu_reg_write(vcpu, regs, 2, uid2);
+	cpu_vcpu_reg_write(vcpu, regs, 3, uid3);
+
+	return true;
+}
+
+static bool fill_revision(struct vmm_vcpu *vcpu, arch_regs_t *regs,
+			  u32 major, u32 minor)
+{
+	/*
+	 * Revision is returned in registers r0 and r1.
+	 * r0 stores major part of the version
+	 * r1 stores minor part of the version
+	 * (ARM DEN 0028B page 15)
+	 */
+	cpu_vcpu_reg_write(vcpu, regs, 0, major);
+	cpu_vcpu_reg_write(vcpu, regs, 1, minor);
+
+	return true;
+}
+
+static bool fill_function_call_count(struct vmm_vcpu *vcpu, arch_regs_t *regs,
+				     u32 cnt)
+{
+	/*
+	 * Function call count is returned as any other return value in register r0
+	 * (ARM DEN 0028B page 17)
+	 */
+	cpu_vcpu_reg_write(vcpu, regs, 0, cnt);
+
+	return true;
+}
+
+/* SMCCC interface for ARM Architecture */
+static bool handle_arch(struct vmm_vcpu *vcpu, arch_regs_t *regs)
+{
+	u32 fid = (u32)cpu_vcpu_reg_read(vcpu, regs, 0);
+
+	switch (fid) {
+	case ARM_SMCCC_VERSION_FID:
+		cpu_vcpu_reg_write(vcpu, regs, 0, ARM_SMCCC_VERSION_1_2);
+		return true;
+
+	case ARM_SMCCC_ARCH_FEATURES_FID:
+	{
+		u32 arch_func_id = cpu_vcpu_reg_read(vcpu, regs, 1);
+		int ret = ARM_SMCCC_NOT_SUPPORTED;
+
+		switch (arch_func_id) {
+		case ARM_SMCCC_ARCH_WORKAROUND_1_FID:
+		case ARM_SMCCC_ARCH_WORKAROUND_3_FID:
+			/* For now, we don't support these workarounds */
+			ret = ARM_SMCCC_NOT_REQUIRED;
+			break;
+		case ARM_SMCCC_ARCH_WORKAROUND_2_FID:
+			/* For now, we don't support this workaround */
+			ret = ARM_SMCCC_NOT_REQUIRED;
+			break;
+		}
+
+		cpu_vcpu_reg_write(vcpu, regs, 0, ret);
+
+		return true;
+	}
+
+	case ARM_SMCCC_ARCH_WORKAROUND_1_FID:
+	case ARM_SMCCC_ARCH_WORKAROUND_3_FID:
+		/* No return value */
+		return true;
+
+	case ARM_SMCCC_ARCH_WORKAROUND_2_FID:
+		/* No return value */
+		return true;
+	}
+
+	return false;
+}
+
+/* SMCCC interface for hypervisor. Tell about itself. */
+static bool handle_hypervisor(struct vmm_vcpu *vcpu, arch_regs_t *regs)
+{
+	u32 fid = (u32)cpu_vcpu_reg_read(vcpu, regs, 0);
+
+	switch (fid) {
+	case ARM_SMCCC_CALL_COUNT_FID(HYPERVISOR):
+		return fill_function_call_count(vcpu, regs,
+						XVISOR_SMCCC_FUNCTION_COUNT);
+	case ARM_SMCCC_CALL_UID_FID(HYPERVISOR):
+		return fill_uid(vcpu, regs, XVISOR_SMCCC_UID_0,
+				XVISOR_SMCCC_UID_1, XVISOR_SMCCC_UID_2,
+				XVISOR_SMCCC_UID_3);
+	case ARM_SMCCC_REVISION_FID(HYPERVISOR):
+		return fill_revision(vcpu, regs, XVISOR_SMCCC_MAJOR_REVISION,
+				     XVISOR_SMCCC_MINOR_REVISION);
+	default:
+		return false;
+	}
+}
+
+/* Existing (pre SMCCC) APIs. This includes PSCI 0.1 interface */
+static bool handle_existing_apis(struct vmm_vcpu *vcpu, arch_regs_t *regs)
+{
+	/* Only least 32 bits are significant (ARM DEN 0028B, page 12) */
+	u32 fid = (u32)cpu_vcpu_reg_read(vcpu, regs, 0);
+
+	/* Try PSCI 0.1 call */
+	if (emulate_psci_call(vcpu, regs, true) == VMM_OK) {
+		return true;
+	}
+
+	return false;
+}
+
+static bool is_psci_fid(u32 fid)
+{
+	u32 fn = fid & ARM_SMCCC_FUNC_MASK;
+
+	/* PSCI function numbers are in range 0x84000000 - 0x8400001F */
+	return (fn >= 0x0000 && fn <= 0x001F);
+}
+
+/* PSCI 0.2 interface and other Standard Secure Calls */
+static bool handle_sssc(struct vmm_vcpu *vcpu, arch_regs_t *regs)
+{
+	u32 fid = (u32)cpu_vcpu_reg_read(vcpu, regs, 0);
+
+	if (is_psci_fid(fid)) {
+		if (emulate_psci_call(vcpu, regs, true) == VMM_OK) {
+			return true;
+		}
+	}
+
+	switch (fid) {
+	case ARM_SMCCC_CALL_COUNT_FID(STANDARD):
+		return fill_function_call_count(vcpu, regs,
+						SSSC_SMCCC_FUNCTION_COUNT);
+
+	case ARM_SMCCC_CALL_UID_FID(STANDARD):
+		return fill_uid(vcpu, regs, SSSC_SMCCC_UID_0,
+				SSSC_SMCCC_UID_1, SSSC_SMCCC_UID_2,
+				SSSC_SMCCC_UID_3);
+
+	case ARM_SMCCC_REVISION_FID(STANDARD):
+		return fill_revision(vcpu, regs, SSSC_SMCCC_MAJOR_REVISION,
+				     SSSC_SMCCC_MINOR_REVISION);
+
+	default:
+		return false;
+	}
+}
+
+/* Secure Calls defined by the Silicon Provider (SiP) */
+static bool handle_sip(struct vmm_vcpu *vcpu, arch_regs_t *regs)
+{
+	/* For now, we don't handle SiP calls */
+	return false;
+}
+
+/*
+ * vsmccc_handle_call() - handle SMC/HVC call according to ARM SMCCC.
+ * returns true if that was valid SMCCC call (even if function number
+ * was unknown).
+ */
+bool vsmccc_handle_call(struct vmm_vcpu *vcpu, arch_regs_t *regs)
+{
+	bool handled = false;
+	u32 funcid = (u32)cpu_vcpu_reg_read(vcpu, regs, 0);
+	bool is_32bit_guest = false;
+
+#ifdef CONFIG_ARM_64
+	/* Check if guest is in 32-bit mode */
+	is_32bit_guest = (regs->pstate & PSR_MODE32) ? true : false;
+#else
+	is_32bit_guest = true;
+#endif
+
+	/* 64 bit calls are allowed only from 64 bit guests. */
+	if (smccc_is_conv_64(funcid) && is_32bit_guest) {
+		cpu_vcpu_reg_write(vcpu, regs, 0,
+				  ARM_SMCCC_ERR_UNKNOWN_FUNCTION);
+		return true;
+	}
+
+	/*
+	 * Special case: identifier range for existing APIs.
+	 * This range is described in SMCCC (ARM DEN 0028B, page 16),
+	 * but it does not conforms to standard function identifier
+	 * encoding.
+	 */
+	if (funcid >= ARM_SMCCC_RESERVED_RANGE_START &&
+	    funcid <= ARM_SMCCC_RESERVED_RANGE_END)
+		handled = handle_existing_apis(vcpu, regs);
+	else {
+		switch (smccc_get_owner(funcid)) {
+		case ARM_SMCCC_OWNER_ARCH:
+			handled = handle_arch(vcpu, regs);
+			break;
+		case ARM_SMCCC_OWNER_HYPERVISOR:
+			handled = handle_hypervisor(vcpu, regs);
+			break;
+		case ARM_SMCCC_OWNER_STANDARD:
+			handled = handle_sssc(vcpu, regs);
+			break;
+		case ARM_SMCCC_OWNER_SIP:
+			handled = handle_sip(vcpu, regs);
+			break;
+		case ARM_SMCCC_OWNER_TRUSTED_APP ... ARM_SMCCC_OWNER_TRUSTED_APP_END:
+		case ARM_SMCCC_OWNER_TRUSTED_OS ... ARM_SMCCC_OWNER_TRUSTED_OS_END:
+			handled = tee_handle_call(vcpu, regs);
+			break;
+		}
+	}
+
+	if (!handled) {
+		vmm_printf("%s: Unhandled SMC/HVC: %#x\n", __func__, funcid);
+
+		/* Inform caller that function is not supported. */
+		cpu_vcpu_reg_write(vcpu, regs, 0,
+				  ARM_SMCCC_ERR_UNKNOWN_FUNCTION);
+	}
+
+	return true;
+}
+
+
+
