diff --git a/arch/arm/cpu/arm32ve/cpu_init.c b/arch/arm/cpu/arm32ve/cpu_init.c
index 0000000..1111111 100644
--- a/arch/arm/cpu/arm32ve/cpu_init.c
+++ b/arch/arm/cpu/arm32ve/cpu_init.c
@@ -26,6 +26,7 @@
 #include <vmm_devtree.h>
 #include <arch_cpu.h>
 #include <arm_psci.h>
+#include <tee.h>
 
 extern u8 _code_start;
 extern u8 _code_end;
@@ -98,6 +99,8 @@ int __init arch_cpu_final_init(void)
 {
 	/* All VMM API's are available here */
 	/* We can register a CPU specific resources here */
+
+	/* Initialize TEE mediator */
+	tee_init();
 
 	return VMM_OK;
 }
diff --git a/arch/arm/cpu/arm32ve/cpu_vcpu_emulate.c b/arch/arm/cpu/arm32ve/cpu_vcpu_emulate.c
index 0000000..1111111 100644
--- a/arch/arm/cpu/arm32ve/cpu_vcpu_emulate.c
+++ b/arch/arm/cpu/arm32ve/cpu_vcpu_emulate.c
@@ -35,6 +35,7 @@
 #include <arm_features.h>
 #include <emulate_psci.h>
 #include <vsmccc.h>
+#include <smccc.h>
 
 /**
  *  Emulate CP15 register access
@@ -420,6 +421,8 @@ int cpu_vcpu_emulate_smc(struct vmm_vcpu *vcpu, 
 			 arch_regs_t *regs, 
 			 u32 il, u32 iss)
 {
+	/* Try SMCCC handler first */
+	if (vsmccc_handle_call(vcpu, regs)) {
+		return VMM_OK;
+	}
+
 	/* Fall back to PSCI for backward compatibility */
 	return do_psci_call(vcpu, regs, il, iss, TRUE);
 }
